# Copy to .env (or set these in your host's dashboard). Nothing here is secret until you fill it in.

# --- required in production ---------------------------------------------------------------
DJANGO_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SITE_URL=https://example.com  # used for links inside e-mails

# --- development only ---------------------------------------------------------------------
# DJANGO_DEBUG=1              # never in production

# --- HTTPS (on by default when DJANGO_DEBUG is off) ----------------------------------------
# DJANGO_BEHIND_PROXY=1       # set when nginx / a PaaS terminates HTTPS and forwards X-Forwarded-Proto
# DJANGO_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000

# --- database (SQLite file by default) -----------------------------------------------------
# DATABASE_URL=postgres://user:password@host:5432/dbname      # also: pip install "psycopg[binary]"

# --- cache and rate limiting (per-process memory by default; use Redis with several workers) --
# REDIS_URL=redis://localhost:6379/1                          # also: pip install redis

# --- e-mail (prints to the console when EMAIL_HOST is empty) --------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=The Jelly Productions <no-reply@example.com>

# --- files ----------------------------------------------------------------------------------
# DJANGO_SERVE_MEDIA=1        # Django serves public uploads (course images, avatars). Set 0 when nginx/S3 does it.
DJANGO_ADMINS=            # "Name:me@example.com" - e-mail every 500 error traceback to these people
# DJANGO_CSP=enforce         # Content-Security-Policy: enforce (default) | report | off
# DJANGO_ADMIN_URL=django-admin/   # move Django's built-in admin to a private address, e.g. staff-8f3k2/
# JELLY_NO_SAMPLE=1            # first 'migrate' only: do not load the original design's sample content (hero pictures, team, gallery, FAQs, articles)
# THROTTLE_MULTIPLIER=3      # all per-address rate limits times 3: for a workshop day when a whole class shares one internet address
